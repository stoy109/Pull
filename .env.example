NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Origin used for auth e-mail links. Set this in every deployment so the
# redirect target does not depend on the incoming Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional postal-code lookup service proxied through
# /api/location/lookup-postal-code. Defaults to http://127.0.0.1:8000.
POSTAL_LOOKUP_API_URL=

# Salin bagian ini ke .env.roles.local hanya untuk akun demo lokal.
UMKM_EMAIL=
UMKM_PASSWORD=
WORKER_EMAIL=
WORKER_PASSWORD=
SUPPLIER_EMAIL=
SUPPLIER_PASSWORD=
