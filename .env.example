NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Origin used for auth e-mail links. Set this in every deployment so the
# redirect target does not depend on the incoming Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional postal-code lookup service proxied through
# /api/location/lookup-postal-code. Defaults to http://127.0.0.1:8000.
POSTAL_LOOKUP_API_URL=

# Phone verification needs an SMS provider configured in Supabase. Leave this
# unset to hide the verification banner and form; set to "true" only after a
# provider is wired up, otherwise every code request fails.
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED=

# E-mail digest for notifications. Runs from /api/notifications/digest, which
# Vercel Cron calls once a day. Leave RESEND_API_KEY or EMAIL_FROM empty and the
# digest stays dormant without touching the in-app inbox.
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
# Without it the digest endpoint refuses to run.
CRON_SECRET=

# Server-only. Needed by the digest to read notifications across users.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Salin bagian ini ke .env.roles.local hanya untuk akun demo lokal.
UMKM_EMAIL=
UMKM_PASSWORD=
WORKER_EMAIL=
WORKER_PASSWORD=
SUPPLIER_EMAIL=
SUPPLIER_PASSWORD=
